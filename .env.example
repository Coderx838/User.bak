# --- Discord ---
DISCORD_TOKEN=put_your_discord_bot_token_here
# Your Discord user ID (the person the bot stands in for). Enable Dev Mode > Right click yourself > Copy User ID
TARGET_USER_ID=put_your_user_id_here
# Only YOU can use control commands. Usually same as TARGET_USER_ID
OWNER_ID=put_your_user_id_here
# Master's real name or preferred handle for personas and prompts (defaults to Discord username/displayName)
MASTER_NAME=Coderx
# Optional webhook for high-priority emergency alerts dispatched by !urgent
EMERGENCY_WEBHOOK_URL=
# Optional private channel ID for persistent message storage (survives Render restarts)
STORAGE_CHANNEL_ID=
# Optional private channel ID for permanent memory, custom personas, and knowledge base
MEMORY_CHANNEL_ID=

# --- Groq (FREE) ---
# Get free key: https://console.groq.com/keys
GROQ_API_KEY=put_your_groq_key_here
# Free + OP models (pick one):
# llama-3.3-70b-versatile (best quality, free)  <- default
# llama-3.1-8b-instant (fastest, free)
GROQ_MODEL=openai/gpt-oss-120b
# Whisper model for voice note and audio transcription (free):
# whisper-large-v3-turbo (fastest, recommended) or whisper-large-v3
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- GIPHY (Optional for Autonomous Reaction GIFs) ---
# Get free key instantly: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# --- VirusTotal (Optional for 24/7 Cloud Phishing & Malware Link Inspection) ---
# Get free key (500 requests/day free): https://www.virustotal.com/gui/my-apikey
# If omitted, User.bak relies on its built-in zero-latency heuristic antivirus engine.
VIRUSTOTAL_API_KEY=

# --- Behavior ---
# auto = replies only when you're offline/idle/DND (via presence) OR manually AFK. 
# on = always reply. off = never reply.
STANDIN_MODE=auto
# extra names that trigger the bot (comma separated, lowercase match). Your username/display name auto-detected too.
TRIGGER_NAMES=yourname,yournickname
# channels to allow. Leave empty = all channels. Comma separated channel IDs.
ALLOWED_CHANNEL_IDS=
# channels to never reply in. Comma separated channel IDs.
IGNORED_CHANNEL_IDS=
# Maximum AI generation calls allowed per day to guard free quota/credits (defaults to 150)
DAILY_AI_LIMIT=150
# Timezone of the owner for digests and alert timestamps (e.g. Asia/Kolkata, America/New_York, UTC)
OWNER_TIMEZONE=Asia/Kolkata

# Edit your personality here. Bot calls you Master and admits it's AI only if directly asked.
SYSTEM_PROMPT=You are {masterName}'s loyal AI cover. You talk casually like him in natural chat-style English with short forms (rn, tbh, idk, gonna, btw, brb, etc.). Speak strictly in English only (never Hindi or Hinglish). You ALWAYS respectfully call him "Master" when talking about him to others in chat. Talk naturally, no AI headers. If directly asked if you're a bot, be honest.
